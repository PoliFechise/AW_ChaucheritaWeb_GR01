<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="AW_ChaucheritaWeb_GR01" transaction-type="RESOURCE_LOCAL">
        <class>model.Cuenta</class>
        <!-- Agrega aquí otras entidades si es necesario -->
        <properties>
            <!-- Configuración de la base de datos -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver" />
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/chaucherita_web" />
            <property name="jakarta.persistence.jdbc.user" value="root" />
            <property name="jakarta.persistence.jdbc.password" value="" />

            <!-- Configuración adicional -->
            <property name="jakarta.persistence.schema-generation.database.action" value="update" />
            <property name="jakarta.persistence.logging.level" value="INFO" />
        </properties>
    </persistence-unit>
</persistence>
